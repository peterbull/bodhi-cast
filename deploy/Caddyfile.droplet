www.{$BODHI_DOMAIN} {
    redir https://{$BODHI_DOMAIN}{uri} permanent
}

{$BODHI_DOMAIN} {
    encode zstd gzip
    reverse_proxy app:8000
    @pages not path /api/* /spots* /addspot
    header @pages Referrer-Policy strict-origin-when-cross-origin
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
    }
}

:80 {
    handle /healthz {
        reverse_proxy app:8000
    }
    handle {
        respond "Bodhi Cast is ready. Domain setup is pending." 200
    }
}
