www.{$BODHI_DOMAIN} {
    redir https://{$BODHI_DOMAIN}{uri} permanent
}

{$BODHI_DOMAIN} {
    encode zstd gzip
    reverse_proxy app:8000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
}

:80 {
    handle /healthz {
        reverse_proxy app:8000
    }
    handle {
        respond "Bodhi Cast is ready. Domain setup is pending." 200
    }
}
